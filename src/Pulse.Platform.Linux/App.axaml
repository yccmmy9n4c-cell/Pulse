<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pulse.Platform.Linux.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#0C121C" />
      <Setter Property="FontFamily" Value="Inter" />
    </Style>
    <Style Selector="Border.heroCard">
      <Setter Property="Background" Value="#101B2A" />
      <Setter Property="BorderBrush" Value="#00A6FF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="22" />
    </Style>
    <Style Selector="Border.standardCard">
      <Setter Property="Background" Value="#101B2A" />
      <Setter Property="BorderBrush" Value="#36516B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="Border.evidenceCard">
      <Setter Property="Background" Value="#0B1522" />
      <Setter Property="BorderBrush" Value="#2B455E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.logCard">
      <Setter Property="Background" Value="#080C10" />
      <Setter Property="BorderBrush" Value="#36516B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="TextBlock.navGroup">
      <Setter Property="Foreground" Value="#718497" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="10,3,0,5" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="#718497" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1" />
    </Style>
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="Foreground" Value="#00A6FF" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.pageHeading">
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.bodyText">
      <Setter Property="Foreground" Value="#DDE7F0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LineHeight" Value="19" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#DDE7F0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#12283A" />
      <Setter Property="BorderBrush" Value="#36516B" />
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="#12304A" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#00A6FF" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#00A6FF" />
      <Setter Property="Foreground" Value="#06101A" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="17,10" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#12283A" />
      <Setter Property="Foreground" Value="#DDE7F0" />
      <Setter Property="BorderBrush" Value="#36516B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="17,9" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#341923" />
      <Setter Property="Foreground" Value="#FF9CAC" />
      <Setter Property="BorderBrush" Value="#8B3445" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="15,9" />
    </Style>
    <Style Selector="Button.compact">
      <Setter Property="Background" Value="#12283A" />
      <Setter Property="Foreground" Value="#DDE7F0" />
      <Setter Property="BorderBrush" Value="#36516B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </Application.Styles>
</Application>
