            <Border Classes="heroCard">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="8">
                  <TextBlock Text="STARTUP INTELLIGENCE" Classes="eyebrow" />
                  <TextBlock x:Name="StartupExecutiveStateText" Text="Pending Assessment" Classes="pageHeading" />
                  <TextBlock x:Name="StartupExecutiveDetailText" Text="Run an assessment to review boot timing, the critical chain, failed services, desktop autostart, and enabled user units." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center" Margin="24,0,0,0">
                  <Button x:Name="StartupAssessButton" Classes="primary" Content="Run Assessment" Click="RunAssessmentButton_OnClick" />
                  <Button x:Name="StartupOpenReportButton" Classes="secondary" Content="Open Latest Report" Click="OpenLatestReportButton_OnClick" IsEnabled="False" />
                </StackPanel>
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,14,*" RowDefinitions="Auto,14,Auto,14,Auto">
              <Border Grid.Row="0" Grid.Column="0" Classes="standardCard"><StackPanel Spacing="9">
                <TextBlock Text="Boot Duration" Classes="cardTitle" />
                <TextBlock x:Name="StartupBootStateText" Text="Pending Assessment" Foreground="#FFD13D" FontWeight="Bold" />
                <TextBlock x:Name="StartupBootDetailText" Text="systemd boot duration has not been assessed." Classes="bodyText" TextWrapping="Wrap" />
              </StackPanel></Border>
              <Border Grid.Row="0" Grid.Column="2" Classes="standardCard"><StackPanel Spacing="9">
                <TextBlock Text="Critical Startup Chain" Classes="cardTitle" />
                <TextBlock x:Name="StartupCriticalStateText" Text="Pending Assessment" Foreground="#FFD13D" FontWeight="Bold" />
                <TextBlock x:Name="StartupCriticalDetailText" Text="The leading systemd startup chain has not been assessed." Classes="bodyText" TextWrapping="Wrap" />
              </StackPanel></Border>
              <Border Grid.Row="2" Grid.Column="0" Classes="standardCard"><StackPanel Spacing="9">
                <TextBlock Text="Failed System Services" Classes="cardTitle" />
                <TextBlock x:Name="StartupSystemFailedStateText" Text="Pending Assessment" Foreground="#FFD13D" FontWeight="Bold" />
                <TextBlock x:Name="StartupSystemFailedDetailText" Text="System-level failed services have not been assessed." Classes="bodyText" TextWrapping="Wrap" />
              </StackPanel></Border>
              <Border Grid.Row="2" Grid.Column="2" Classes="standardCard"><StackPanel Spacing="9">
                <TextBlock Text="Failed User Services" Classes="cardTitle" />
                <TextBlock x:Name="StartupUserFailedStateText" Text="Pending Assessment" Foreground="#FFD13D" FontWeight="Bold" />
                <TextBlock x:Name="StartupUserFailedDetailText" Text="Signed-in user failed services have not been assessed." Classes="bodyText" TextWrapping="Wrap" />
              </StackPanel></Border>
              <Border Grid.Row="4" Grid.Column="0" Classes="standardCard"><StackPanel Spacing="9">
                <TextBlock Text="Desktop Autostart" Classes="cardTitle" />
                <TextBlock x:Name="StartupDesktopStateText" Text="Pending Assessment" Foreground="#FFD13D" FontWeight="Bold" />
                <TextBlock x:Name="StartupDesktopDetailText" Text="XDG desktop-autostart entries have not been assessed." Classes="bodyText" TextWrapping="Wrap" />
              </StackPanel></Border>
              <Border Grid.Row="4" Grid.Column="2" Classes="standardCard"><StackPanel Spacing="9">
                <TextBlock Text="Enabled User Services and Timers" Classes="cardTitle" />
                <TextBlock x:Name="StartupEnabledUserStateText" Text="Pending Assessment" Foreground="#FFD13D" FontWeight="Bold" />
                <TextBlock x:Name="StartupEnabledUserDetailText" Text="Enabled user services and timers have not been assessed." Classes="bodyText" TextWrapping="Wrap" />
              </StackPanel></Border>
            </Grid>

            <Border Classes="standardCard"><StackPanel Spacing="8">
              <TextBlock Text="Recommended Next Step" Classes="cardTitle" />
              <TextBlock x:Name="StartupRecommendationText" Text="Run an assessment to establish Startup Intelligence." Classes="bodyText" TextWrapping="Wrap" />
              <Button x:Name="StartupReviewActionButton" Classes="secondary" Content="Review Details" HorizontalAlignment="Left" IsEnabled="False" Click="ReviewActionButton_OnClick" />
              <TextBlock Text="Startup evidence is local and read-only. Pulse does not enable, disable, start, stop, mask, unmask, or remove services, timers, or desktop-autostart entries." Foreground="#718497" FontSize="10" TextWrapping="Wrap" />
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ReliabilityPage" IsVisible="False" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="26,22" Spacing="18">
            <Border Classes="heroCard">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="8">
                  <TextBlock Text="RELIABILITY INTELLIGENCE" Classes="eyebrow" />
                  <TextBlock x:Name="ReliabilityExecutiveStateText" Text="Pending Assessment" Classes="pageHeading" />
                  <TextBlock x:Name="ReliabilityExecutiveDetailText" Text="Run an assessment to review current-boot errors, failed services, boot timing, uptime, and restart posture." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center" Margin="24,0,0,0">
                  <Button x:Name="ReliabilityAssessButton" Classes="primary" Content="Run Assessment" Click="RunAssessmentButton_OnClick" />
                  <Button x:Name="ReliabilityOpenReportButton" Classes="secondary" Content="Open Latest Report" Click="OpenLatestReportButton_OnClick" IsEnabled="False" />
                </StackPanel>
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,14,*" RowDefinitions="Auto,14,Auto,14,Auto">
              <Border Grid.Row="0" Grid.Column="0" Classes="standardCard">
                <StackPanel Spacing="9">
                  <TextBlock Text="Current-Boot Journal" Classes="cardTitle" />
                  <TextBlock x:Name="ReliabilityJournalStateText" Text="Pending Assessment" Foreground="#FFD13D" FontWeight="Bold" />
                  <TextBlock x:Name="ReliabilityJournalDetailText" Text="User-readable error severity and source counts have not been assessed." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Row="0" Grid.Column="2" Classes="standardCard">
                <StackPanel Spacing="9">
                  <TextBlock Text="Failed System Services" Classes="cardTitle" />
                  <TextBlock x:Name="ReliabilitySystemServicesStateText" Text="Pending Assessment" Foreground="#FFD13D" FontWeight="Bold" />
                  <TextBlock x:Name="ReliabilitySystemServicesDetailText" Text="System-level failed service state has not been assessed." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Row="2" Grid.Column="0" Classes="standardCard">
                <StackPanel Spacing="9">
                  <TextBlock Text="Failed User Services" Classes="cardTitle" />
                  <TextBlock x:Name="ReliabilityUserServicesStateText" Text="Pending Assessment" Foreground="#FFD13D" FontWeight="Bold" />
                  <TextBlock x:Name="ReliabilityUserServicesDetailText" Text="Signed-in user service state has not been assessed." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Row="2" Grid.Column="2" Classes="standardCard">
                <StackPanel Spacing="9">
                  <TextBlock Text="Boot Timing" Classes="cardTitle" />
                  <TextBlock x:Name="ReliabilityBootStateText" Text="Pending Assessment" Foreground="#FFD13D" FontWeight="Bold" />
                  <TextBlock x:Name="ReliabilityBootDetailText" Text="systemd boot duration has not been recorded." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Row="4" Grid.Column="0" Classes="standardCard">
                <StackPanel Spacing="9">
                  <TextBlock Text="System Uptime" Classes="cardTitle" />
                  <TextBlock x:Name="ReliabilityUptimeStateText" Text="Pending Assessment" Foreground="#FFD13D" FontWeight="Bold" />
                  <TextBlock x:Name="ReliabilityUptimeDetailText" Text="The current Linux uptime baseline has not been recorded." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Row="4" Grid.Column="2" Classes="standardCard">
                <StackPanel Spacing="9">
                  <TextBlock Text="Restart Posture" Classes="cardTitle" />
                  <TextBlock x:Name="ReliabilityRestartStateText" Text="Pending Assessment" Foreground="#FFD13D" FontWeight="Bold" />
                  <TextBlock x:Name="ReliabilityRestartDetailText" Text="Debian's package restart marker has not been assessed." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Classes="standardCard">
              <StackPanel Spacing="8">
                <TextBlock Text="Recommended Next Step" Classes="cardTitle" />
                <TextBlock x:Name="ReliabilityRecommendationText" Text="Run an assessment to establish Reliability Intelligence." Classes="bodyText" TextWrapping="Wrap" />
                <Button x:Name="ReliabilityReviewActionButton" Classes="secondary" Content="Review Details" HorizontalAlignment="Left" IsEnabled="False" Click="ReviewActionButton_OnClick" />
                <TextBlock Text="Pulse reads metadata and service state only. It does not copy journal messages, restart services, reset failures, change startup configuration, or reboot the computer." Foreground="#718497" FontSize="10" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ReportsPage" IsVisible="False" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="26,22" Spacing="18">
            <Border Classes="heroCard">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="8">
                  <TextBlock Text="PRIMARY HTML REPORTS" Classes="eyebrow" />
                  <TextBlock Text="Pulse Health Report" Classes="pageHeading" />
                  <TextBlock Text="Aurora-styled HTML reports open in your browser and support Print / Save as PDF." Classes="bodyText" TextWrapping="Wrap" />
                  <TextBlock x:Name="LatestReportText" Text="No report has been generated yet." Foreground="#9FB0C0" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center" Margin="24,0,0,0">
                  <Button x:Name="ReportsOpenLatestButton" Classes="primary" Content="Open Latest Report" Click="OpenLatestReportButton_OnClick" IsEnabled="False" />
                  <Button Classes="secondary" Content="Open HTML Reports" Click="OpenReportsFolderButton_OnClick" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="standardCard">
              <StackPanel Spacing="12">
                <TextBlock Text="Recent HTML Reports" Classes="cardTitle" />
                <StackPanel x:Name="RecentReportsPanel" Spacing="8">
                  <TextBlock Text="No saved reports." Classes="bodyText" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="standardCard">
              <StackPanel Spacing="8">
                <TextBlock Text="Archived PDFs" Classes="cardTitle" />
                <TextBlock Text="HTML is the primary Pulse report format. Use your browser's Print / Save as PDF command when an archived PDF is needed." Classes="bodyText" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="SchedulerPage" IsVisible="False" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="26,22" Spacing="18">
            <Border Classes="heroCard">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="8">
                  <TextBlock Text="AUTOMATIC HEALTH SCANS" Classes="eyebrow" />
                  <TextBlock x:Name="SchedulerStateText" Text="Checking Schedule…" Classes="pageHeading" />
                  <TextBlock x:Name="SchedulerDetailText" Text="Reading systemd --user status…" Classes="bodyText" TextWrapping="Wrap" />
                  <TextBlock Text="Cadence: Weekly • Persistent catch-up • Up to 30-minute randomized delay" Foreground="#9FB0C0" FontSize="11" />
                </StackPanel>
                <Button x:Name="ScheduleButton" Grid.Column="1" Classes="primary" Content="Checking Schedule…" Click="ScheduleButton_OnClick" IsEnabled="False" VerticalAlignment="Center" Margin="24,0,0,0" />
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,14,*">
              <Border Grid.Column="0" Classes="standardCard">
                <StackPanel Spacing="9">
                  <TextBlock Text="What Pulse Runs" Classes="cardTitle" />
                  <TextBlock Text="The same Debian-family support gate and read-only evidence providers used by Run Assessment. Reports are saved without opening the graphical interface." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="standardCard">
                <StackPanel Spacing="9">
                  <TextBlock Text="Approval Boundary" Classes="cardTitle" />
                  <TextBlock Text="Scheduling is off by default. Enabling requires a second confirmation. Pulse uses systemd --user without sudo, Polkit, or a system-wide service." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="LogsPage" IsVisible="False" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="26,22" Spacing="18">
            <Border Classes="standardCard">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="7">
                  <TextBlock Text="PULSE EVENT LOG" Classes="eyebrow" />
                  <TextBlock Text="Assessment Activity" Classes="pageHeading" />
                  <TextBlock x:Name="LogsLocationText" Text="Loading log location…" Foreground="#9FB0C0" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Classes="secondary" Content="Refresh Logs" Click="RefreshLogsButton_OnClick" />
                  <Button Classes="secondary" Content="Open Logs Folder" Click="OpenLogsFolderButton_OnClick" />
                  <Button x:Name="ClearLogButton" Classes="danger" Content="Clear Event Log" Click="ClearLogButton_OnClick" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Classes="logCard">
              <TextBlock x:Name="LogsText" Text="No Pulse activity has been recorded." FontFamily="monospace" FontSize="11" Foreground="#C7D3DF" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="UpdatesPage" IsVisible="False" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="26,22" Spacing="18">
            <Border Classes="heroCard">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="8">
                  <TextBlock Text="PULSE RELEASE UPDATES" Classes="eyebrow" />
                  <TextBlock x:Name="UpdateStateText" Text="Ready to Check" Classes="pageHeading" />
                  <TextBlock x:Name="UpdateDetailText" Text="Pulse checks GitHub only when you choose Check for Updates. No background or startup request is made." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="CheckForUpdatesButton" Grid.Column="1" Classes="primary" Content="Check for Updates" Click="CheckForUpdatesButton_OnClick" VerticalAlignment="Center" Margin="24,0,0,0" />
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,14,*">
              <Border Grid.Column="0" Classes="standardCard">
                <StackPanel Spacing="10">
                  <TextBlock Text="Installed Pulse" Classes="cardTitle" />
                  <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Text="Version:" Classes="bodyText" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="UpdateInstalledVersionText" Foreground="#FFFFFF" FontWeight="Bold" />
                    <TextBlock Grid.Row="1" Text="Channel:" Classes="bodyText" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Beta" Foreground="#FFD13D" FontWeight="Bold" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="2" Text="Architecture:" Classes="bodyText" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="UpdateArchitectureText" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,7,0,0" />
                  </Grid>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="standardCard">
                <StackPanel Spacing="10">
                  <TextBlock Text="Available Release" Classes="cardTitle" />
                  <TextBlock x:Name="UpdateLatestVersionText" Text="Not checked" Foreground="#9FB0C0" FontSize="18" FontWeight="Bold" />
                  <TextBlock x:Name="UpdatePackageText" Text="Compatible package selection will appear after a check." Classes="bodyText" TextWrapping="Wrap" />
                  <Button x:Name="ViewReleaseButton" Classes="secondary" Content="View Release on GitHub" HorizontalAlignment="Left" IsEnabled="False" Click="ViewReleaseButton_OnClick" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Classes="standardCard">
              <StackPanel Spacing="10">
                <TextBlock Text="Release Notes" Classes="cardTitle" />
                <TextBlock x:Name="UpdateReleaseNotesText" Text="Release notes will appear here after a successful update check." Classes="bodyText" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="standardCard">
              <StackPanel Spacing="11">
                <TextBlock Text="Download and Install" Classes="cardTitle" />
                <TextBlock Text="Pulse downloads the architecture-specific Debian package to your Downloads folder and verifies it against the release SHA-256 checksum before enabling installation." Classes="bodyText" TextWrapping="Wrap" />
                <ProgressBar x:Name="UpdateDownloadProgress" Minimum="0" Maximum="100" Value="0" Height="10" IsVisible="False" />
                <TextBlock x:Name="UpdateDownloadStatusText" Text="No update has been downloaded." Foreground="#9FB0C0" FontSize="11" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="DownloadUpdateButton" Classes="primary" Content="Download Update" IsEnabled="False" Click="DownloadUpdateButton_OnClick" />
                  <Button x:Name="OpenUpdateInstallerButton" Classes="secondary" Content="Open Installer" IsEnabled="False" Click="OpenUpdateInstallerButton_OnClick" />
                </StackPanel>
                <TextBlock Text="Opening the installer does not install silently. Your normal graphical package installer controls confirmation and any required authentication." Foreground="#718497" FontSize="10" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="MissionControlPage" IsVisible="False" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="26,22" Spacing="18">
            <StackPanel Spacing="3">
              <TextBlock Text="Supernova Mission Control" Classes="pageHeading" />
              <TextBlock Text="Intelligence. UNIFIED." Foreground="#FFD13D" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>

            <Border Classes="heroCard">
              <Grid ColumnDefinitions="*,1,*">
                <StackPanel Grid.Column="0" Spacing="10" Margin="0,0,28,0">
                  <TextBlock Text="Current Mission" Classes="cardTitle" />
                  <TextBlock Text="Pulse Supernova Linux" Foreground="#FFD13D" FontSize="24" FontWeight="Bold" />
                  <TextBlock Text="Debian-family intelligence, GitHub release lifecycle, and extended-use testing." Classes="bodyText" TextWrapping="Wrap" />
                  <TextBlock Text="Mission Status: GitHub-enabled Linux beta build" Foreground="#00A6FF" FontWeight="Bold" />
                </StackPanel>
                <Border Grid.Column="1" Background="#00A6FF" Width="1" />
                <StackPanel Grid.Column="2" Spacing="10" Margin="28,0,0,0">
                  <TextBlock Text="What Pulse Does" Classes="cardTitle" />
                  <TextBlock Classes="bodyText" TextWrapping="Wrap"
                             Text="Pulse helps you understand the health, reliability, security posture, storage, and performance of your computer in one place. It explains what looks healthy and what may need attention, tracks changes over time, creates reports, and guides you to appropriate actions. Pulse will never silently repair or change your system without your consent." />
                </StackPanel>
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,14,*">
              <Border Grid.Column="0" Classes="standardCard">
                <StackPanel Spacing="11">
                  <TextBlock Text="Developer Information" Classes="cardTitle" />
                  <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Text="Development Version:" Classes="bodyText" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="MissionVersionText" Text="0.0.0.29" Foreground="#FFFFFF" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="Release Channel:" Classes="bodyText" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Beta" Foreground="#FFD13D" FontWeight="SemiBold" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="2" Text="Framework:" Classes="bodyText" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text=".NET 10 • Avalonia" Foreground="#FFFFFF" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="3" Text="Build ID:" Classes="bodyText" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="MissionBuildIdText" Text="linux-x64-0.0.0.29" Foreground="#FFFFFF" Margin="0,7,0,0" TextWrapping="Wrap" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Classes="standardCard">
                <StackPanel Spacing="11">
                  <TextBlock Text="System Information" Classes="cardTitle" />
                  <Grid ColumnDefinitions="118,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Text="Computer:" Classes="bodyText" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="MissionComputerText" Foreground="#FFFFFF" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="Distribution:" Classes="bodyText" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="MissionDistributionText" Foreground="#FFFFFF" Margin="0,7,0,0" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Text="Reports Folder:" Classes="bodyText" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MissionReportsFolderText" Foreground="#FFFFFF" Margin="0,7,0,0" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" Text="Settings Folder:" Classes="bodyText" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="MissionSettingsFolderText" Foreground="#FFFFFF" Margin="0,7,0,0" TextWrapping="Wrap" />
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>

            <Border Classes="standardCard">
              <StackPanel Spacing="8">
                <TextBlock Text="Pulse Supernova Linux" Classes="cardTitle" />
                <TextBlock Text="Linux launch identity" Foreground="#FFD13D" FontSize="17" FontWeight="Bold" />
                <TextBlock Text="Supernova preserves accepted Pulse intelligence and data while extending the unified product identity to verified Debian-family desktop systems." Classes="bodyText" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Border Grid.Row="2" Background="#080D16" BorderBrush="#24374A" BorderThickness="0,1,0,0" Padding="20,10">
        <Grid ColumnDefinitions="Auto,*,Auto,10,Auto">
          <TextBlock Text="ACTIVITY" Foreground="#00A6FF" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" x:Name="ActivityText" Text="Pulse Supernova Linux ready." Foreground="#9FB0C0" FontSize="11" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="2" Classes="compact" Content="Refresh Pulse" Click="RefreshPulseButton_OnClick" />
          <Button Grid.Column="4" Classes="compact" Content="Exit" Click="ExitButton_OnClick" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
