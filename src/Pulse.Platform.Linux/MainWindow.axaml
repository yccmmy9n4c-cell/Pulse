<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Pulse.Platform.Linux.MainWindow"
        Title="Pulse Supernova Linux"
        Icon="/Assets/pulse-platform.png"
        Width="1180" Height="780"
        MinWidth="1040" MinHeight="700">
  <Grid ColumnDefinitions="230,*">
    <Border Grid.Column="0" Background="#080D16" BorderBrush="#24374A" BorderThickness="0,0,1,0">
      <Grid Margin="16" RowDefinitions="Auto,24,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="68,*">
          <Border Width="60" Height="60" CornerRadius="14" Background="#0C1623" BorderBrush="#36516B" BorderThickness="1">
            <Image Source="/Assets/PulseLogo-Dark.png" Stretch="UniformToFill" Margin="2" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
            <TextBlock Text="PULSE" Foreground="#00A6FF" FontSize="25" FontWeight="Bold" LetterSpacing="1.5" />
            <TextBlock Text="SUPERNOVA LINUX" Foreground="#FFD13D" FontSize="11" FontWeight="Bold" />
          </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="5">
            <TextBlock Text="PULSE HEALTH PLATFORM" Classes="navGroup" />
            <Button x:Name="DashboardNavButton" Classes="nav selected" Tag="Dashboard" Content="⌂   Dashboard" Click="NavigateButton_OnClick" />
            <Button x:Name="AssessmentNavButton" Classes="nav" Tag="Assessment" Content="◉   Linux Assessment" Click="NavigateButton_OnClick" />
            <Button x:Name="PackageNavButton" Classes="nav" Tag="Package" Content="▦   Package Intelligence" Click="NavigateButton_OnClick" />
            <Button x:Name="NetworkNavButton" Classes="nav" Tag="Network" Content="◎   Network Intelligence" Click="NavigateButton_OnClick" />
            <Button x:Name="StorageNavButton" Classes="nav" Tag="Storage" Content="▣   Storage Intelligence" Click="NavigateButton_OnClick" />
            <Button x:Name="SecurityNavButton" Classes="nav" Tag="Security" Content="◆   Security Intelligence" Click="NavigateButton_OnClick" />
            <Button x:Name="PerformanceNavButton" Classes="nav" Tag="Performance" Content="⚡   Performance Intelligence" Click="NavigateButton_OnClick" />
            <Button x:Name="HardwareNavButton" Classes="nav" Tag="Hardware" Content="▧   Hardware Intelligence" Click="NavigateButton_OnClick" />
            <Button x:Name="StartupNavButton" Classes="nav" Tag="Startup" Content="▷   Startup Intelligence" Click="NavigateButton_OnClick" />
            <Button x:Name="ReliabilityNavButton" Classes="nav" Tag="Reliability" Content="◈   Reliability Intelligence" Click="NavigateButton_OnClick" />
            <Button x:Name="ReportsNavButton" Classes="nav" Tag="Reports" Content="▤   Reports" Click="NavigateButton_OnClick" />

            <Border Height="1" Background="#24445E" Margin="10,15,10,12" />
            <TextBlock Text="PULSE ADMINISTRATION" Classes="navGroup" />
            <Button x:Name="SchedulerNavButton" Classes="nav" Tag="Scheduler" Content="◷   Scheduler" Click="NavigateButton_OnClick" />
            <Button x:Name="LogsNavButton" Classes="nav" Tag="Logs" Content="≡   Logs" Click="NavigateButton_OnClick" />
            <Button x:Name="UpdatesNavButton" Classes="nav" Tag="Updates" Content="↓   Updates" Click="NavigateButton_OnClick" />
            <Button x:Name="MissionControlNavButton" Classes="nav" Tag="MissionControl" Content="✦   Mission Control" Click="NavigateButton_OnClick" />
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Spacing="4" Margin="6,16,6,4">
          <TextBlock Text="System Health. Optimized." Foreground="#FFD13D" FontSize="11" FontWeight="SemiBold" />
          <TextBlock Text="Debian-family desktop port" Foreground="#718497" FontSize="10" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="82,*,62" Background="#0C121C">
      <Border Grid.Row="0" BorderBrush="#24374A" BorderThickness="0,0,0,1" Padding="26,16">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle" Text="Dashboard" Foreground="#00A6FF" FontSize="25" FontWeight="Bold" />
            <TextBlock Text="System Health. Optimized." Foreground="#B7C4D1" FontSize="12" />
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
            <TextBlock x:Name="VersionNameText" Text="Pulse Supernova Linux • Beta" Foreground="#FFD13D" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
            <TextBlock x:Name="BuildIdText" Text="Build ID: linux-x64" Foreground="#718497" FontSize="10" HorizontalAlignment="Right" Margin="0,5,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="26,20" Spacing="14">
            <Border Classes="standardCard" Padding="20">
              <Grid ColumnDefinitions="*,18,280" RowDefinitions="Auto,*">
                <Grid Grid.Row="0" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Current System State" Classes="pageHeading" />
                    <TextBlock x:Name="DashboardPlatformText" Text="Detecting platform…" Foreground="#9FB0C0" FontSize="11" />
                    <TextBlock x:Name="DashboardLastAssessmentText" Text="No saved assessment yet." Foreground="#718497" FontSize="10" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="DashboardAssessButton" Classes="primary" Content="Run Assessment" Click="RunAssessmentButton_OnClick" />
                    <Button x:Name="DashboardOpenReportButton" Classes="secondary" Content="Open Report" Click="OpenLatestReportButton_OnClick" IsEnabled="False" />
                  </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="18,190,150,170" RowDefinitions="36,36,36,36,36,36,36,36,36">
                  <Border x:Name="PlatformDomainDot" Grid.Row="0" Width="9" Height="9" CornerRadius="5" Background="#00A6FF" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="Linux Intelligence" Classes="bodyText" FontWeight="Bold" VerticalAlignment="Center" />
                  <TextBlock x:Name="PlatformDomainStateText" Grid.Row="0" Grid.Column="2" Text="Pending" Foreground="#00A6FF" FontWeight="Bold" VerticalAlignment="Center" />
                  <Grid Grid.Row="0" Grid.Column="3" ColumnDefinitions="135,*" VerticalAlignment="Center">
                    <Border Width="135" Height="11" Background="#102333" BorderBrush="#00A6FF" BorderThickness="1" HorizontalAlignment="Left">
                      <Border x:Name="PlatformDomainFill" Width="0" Background="#00A6FF" HorizontalAlignment="Left" />
                    </Border>
                    <TextBlock x:Name="PlatformDomainScoreText" Grid.Column="1" Text="--" Foreground="#DDE7F0" Margin="9,-2,0,0" />
                  </Grid>

                  <Border x:Name="PackageDomainDot" Grid.Row="1" Width="9" Height="9" CornerRadius="5" Background="#00A6FF" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="Package Intelligence" Classes="bodyText" FontWeight="Bold" VerticalAlignment="Center" />
                  <TextBlock x:Name="PackageDomainStateText" Grid.Row="1" Grid.Column="2" Text="Pending" Foreground="#00A6FF" FontWeight="Bold" VerticalAlignment="Center" />
                  <Grid Grid.Row="1" Grid.Column="3" ColumnDefinitions="135,*" VerticalAlignment="Center">
                    <Border Width="135" Height="11" Background="#102333" BorderBrush="#00A6FF" BorderThickness="1" HorizontalAlignment="Left"><Border x:Name="PackageDomainFill" Width="0" Background="#00A6FF" HorizontalAlignment="Left" /></Border>
                    <TextBlock x:Name="PackageDomainScoreText" Grid.Column="1" Text="--" Foreground="#DDE7F0" Margin="9,-2,0,0" />
                  </Grid>

                  <Border x:Name="NetworkDomainDot" Grid.Row="2" Width="9" Height="9" CornerRadius="5" Background="#00A6FF" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="Network Intelligence" Classes="bodyText" FontWeight="Bold" VerticalAlignment="Center" />
                  <TextBlock x:Name="NetworkDomainStateText" Grid.Row="2" Grid.Column="2" Text="Pending" Foreground="#00A6FF" FontWeight="Bold" VerticalAlignment="Center" />
                  <Grid Grid.Row="2" Grid.Column="3" ColumnDefinitions="135,*" VerticalAlignment="Center">
                    <Border Width="135" Height="11" Background="#102333" BorderBrush="#00A6FF" BorderThickness="1" HorizontalAlignment="Left"><Border x:Name="NetworkDomainFill" Width="0" Background="#00A6FF" HorizontalAlignment="Left" /></Border>
                    <TextBlock x:Name="NetworkDomainScoreText" Grid.Column="1" Text="--" Foreground="#DDE7F0" Margin="9,-2,0,0" />
                  </Grid>

                  <Border x:Name="StorageDomainDot" Grid.Row="3" Width="9" Height="9" CornerRadius="5" Background="#00A6FF" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="Storage Intelligence" Classes="bodyText" FontWeight="Bold" VerticalAlignment="Center" />
                  <TextBlock x:Name="StorageDomainStateText" Grid.Row="3" Grid.Column="2" Text="Pending" Foreground="#00A6FF" FontWeight="Bold" VerticalAlignment="Center" />
                  <Grid Grid.Row="3" Grid.Column="3" ColumnDefinitions="135,*" VerticalAlignment="Center">
                    <Border Width="135" Height="11" Background="#102333" BorderBrush="#00A6FF" BorderThickness="1" HorizontalAlignment="Left"><Border x:Name="StorageDomainFill" Width="0" Background="#00A6FF" HorizontalAlignment="Left" /></Border>
                    <TextBlock x:Name="StorageDomainScoreText" Grid.Column="1" Text="--" Foreground="#DDE7F0" Margin="9,-2,0,0" />
                  </Grid>

                  <Border x:Name="SecurityDomainDot" Grid.Row="4" Width="9" Height="9" CornerRadius="5" Background="#00A6FF" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="Security Intelligence" Classes="bodyText" FontWeight="Bold" VerticalAlignment="Center" />
                  <TextBlock x:Name="SecurityDomainStateText" Grid.Row="4" Grid.Column="2" Text="Pending" Foreground="#00A6FF" FontWeight="Bold" VerticalAlignment="Center" />
                  <Grid Grid.Row="4" Grid.Column="3" ColumnDefinitions="135,*" VerticalAlignment="Center">
                    <Border Width="135" Height="11" Background="#102333" BorderBrush="#00A6FF" BorderThickness="1" HorizontalAlignment="Left"><Border x:Name="SecurityDomainFill" Width="0" Background="#00A6FF" HorizontalAlignment="Left" /></Border>
                    <TextBlock x:Name="SecurityDomainScoreText" Grid.Column="1" Text="--" Foreground="#DDE7F0" Margin="9,-2,0,0" />
                  </Grid>

                  <Border x:Name="PerformanceDomainDot" Grid.Row="5" Width="9" Height="9" CornerRadius="5" Background="#00A6FF" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="5" Grid.Column="1" Text="Performance Intelligence" Classes="bodyText" FontWeight="Bold" VerticalAlignment="Center" />
                  <TextBlock x:Name="PerformanceDomainStateText" Grid.Row="5" Grid.Column="2" Text="Pending" Foreground="#00A6FF" FontWeight="Bold" VerticalAlignment="Center" />
                  <Grid Grid.Row="5" Grid.Column="3" ColumnDefinitions="135,*" VerticalAlignment="Center">
                    <Border Width="135" Height="11" Background="#102333" BorderBrush="#00A6FF" BorderThickness="1" HorizontalAlignment="Left"><Border x:Name="PerformanceDomainFill" Width="0" Background="#00A6FF" HorizontalAlignment="Left" /></Border>
                    <TextBlock x:Name="PerformanceDomainScoreText" Grid.Column="1" Text="--" Foreground="#DDE7F0" Margin="9,-2,0,0" />
                  </Grid>

                  <Border x:Name="HardwareDomainDot" Grid.Row="6" Width="9" Height="9" CornerRadius="5" Background="#00A6FF" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="6" Grid.Column="1" Text="Hardware Intelligence" Classes="bodyText" FontWeight="Bold" VerticalAlignment="Center" />
                  <TextBlock x:Name="HardwareDomainStateText" Grid.Row="6" Grid.Column="2" Text="Pending" Foreground="#00A6FF" FontWeight="Bold" VerticalAlignment="Center" />
                  <Grid Grid.Row="6" Grid.Column="3" ColumnDefinitions="135,*" VerticalAlignment="Center">
                    <Border Width="135" Height="11" Background="#102333" BorderBrush="#00A6FF" BorderThickness="1" HorizontalAlignment="Left"><Border x:Name="HardwareDomainFill" Width="0" Background="#00A6FF" HorizontalAlignment="Left" /></Border>
                    <TextBlock x:Name="HardwareDomainScoreText" Grid.Column="1" Text="--" Foreground="#DDE7F0" Margin="9,-2,0,0" />
                  </Grid>

                  <Border x:Name="StartupDomainDot" Grid.Row="7" Width="9" Height="9" CornerRadius="5" Background="#00A6FF" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="7" Grid.Column="1" Text="Startup Intelligence" Classes="bodyText" FontWeight="Bold" VerticalAlignment="Center" />
                  <TextBlock x:Name="StartupDomainStateText" Grid.Row="7" Grid.Column="2" Text="Pending" Foreground="#00A6FF" FontWeight="Bold" VerticalAlignment="Center" />
                  <Grid Grid.Row="7" Grid.Column="3" ColumnDefinitions="135,*" VerticalAlignment="Center">
                    <Border Width="135" Height="11" Background="#102333" BorderBrush="#00A6FF" BorderThickness="1" HorizontalAlignment="Left"><Border x:Name="StartupDomainFill" Width="0" Background="#00A6FF" HorizontalAlignment="Left" /></Border>
                    <TextBlock x:Name="StartupDomainScoreText" Grid.Column="1" Text="--" Foreground="#DDE7F0" Margin="9,-2,0,0" />
                  </Grid>

                  <Border x:Name="ReliabilityDomainDot" Grid.Row="8" Width="9" Height="9" CornerRadius="5" Background="#00A6FF" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="8" Grid.Column="1" Text="Reliability Intelligence" Classes="bodyText" FontWeight="Bold" VerticalAlignment="Center" />
                  <TextBlock x:Name="ReliabilityDomainStateText" Grid.Row="8" Grid.Column="2" Text="Pending" Foreground="#00A6FF" FontWeight="Bold" VerticalAlignment="Center" />
                  <Grid Grid.Row="8" Grid.Column="3" ColumnDefinitions="135,*" VerticalAlignment="Center">
                    <Border Width="135" Height="11" Background="#102333" BorderBrush="#00A6FF" BorderThickness="1" HorizontalAlignment="Left"><Border x:Name="ReliabilityDomainFill" Width="0" Background="#00A6FF" HorizontalAlignment="Left" /></Border>
                    <TextBlock x:Name="ReliabilityDomainScoreText" Grid.Column="1" Text="--" Foreground="#DDE7F0" Margin="9,-2,0,0" />
                  </Grid>
                </Grid>

                <Border Grid.Row="1" Grid.Column="2" Background="#090F18" BorderBrush="#00A6FF" BorderThickness="1" CornerRadius="14" Padding="18">
                  <StackPanel Spacing="7" HorizontalAlignment="Center">
                    <TextBlock Text="Executive Health" Foreground="#00A6FF" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="DashboardExecutiveScoreText" Text="--" Foreground="#00A6FF" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                      <Border x:Name="DashboardHealthDot" Width="10" Height="10" CornerRadius="5" Background="#00A6FF" VerticalAlignment="Center" />
                      <TextBlock x:Name="DashboardStateText" Text="Assessment Ready" Foreground="#00A6FF" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock x:Name="DashboardSummaryText" Text="Run an assessment to establish health." Foreground="#9FB0C0" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="225" />
                    <Grid Width="220" Height="13" ColumnDefinitions="*,*,*,*" Margin="0,5,0,0">
                      <Border Grid.Column="0" Background="#FF5B6E" CornerRadius="7,0,0,7" />
                      <Border Grid.Column="1" Background="#FF9F1C" />
                      <Border Grid.Column="2" Background="#FFD13D" />
                      <Border Grid.Column="3" Background="#5CFF88" CornerRadius="0,7,7,0" />
                    </Grid>
                    <Canvas Width="220" Height="16">
                      <TextBlock x:Name="DashboardGaugePointer" Text="▲" Foreground="#00A6FF" Canvas.Left="0" Canvas.Top="-4" />
                    </Canvas>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,14,*,14,*">
              <Border Grid.Column="0" Classes="standardCard" MinHeight="128">
                <StackPanel Spacing="8">
                  <TextBlock Text="Top Risk" Classes="cardTitle" />
                  <TextBlock x:Name="TopRiskText" Text="Assessment data has not been collected." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="standardCard" MinHeight="128">
                <StackPanel Spacing="8">
                  <TextBlock Text="Recent Changes" Classes="cardTitle" />
                  <TextBlock x:Name="RecentChangesText" Text="No assessment history yet." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Classes="standardCard" MinHeight="128">
                <Grid RowDefinitions="Auto,*,Auto">
                  <TextBlock Text="Supernova Advisor" Classes="cardTitle" />
                  <TextBlock Grid.Row="1" x:Name="RecommendationsText" Text="Run an assessment for plain-language guidance." Classes="bodyText" TextWrapping="Wrap" Margin="0,8,0,0" />
                  <Border x:Name="RequiredActionBorder" Grid.Row="2" Background="#12283A" BorderBrush="#36516B" BorderThickness="1" CornerRadius="7" Padding="8,5">
                    <TextBlock x:Name="RequiredActionText" Text="Assessment Required" Foreground="#DDE7F0" FontWeight="Bold" HorizontalAlignment="Center" />
                  </Border>
                </Grid>
              </Border>
            </Grid>

            <Border Classes="standardCard" Padding="16">
              <StackPanel Spacing="7">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Text="System Trend" Classes="cardTitle" />
                  <TextBlock Grid.Column="1" x:Name="SystemTrendText" Text="Trend data will appear after additional assessments." Foreground="#5CFF88" Margin="18,2,0,0" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="2" x:Name="DashboardEvidenceCountText" Text="0 evidence sources" Foreground="#9FB0C0" />
                </Grid>
                <Canvas x:Name="SystemTrendCanvas" Height="105" Background="#090F18">
                  <Border Width="860" Height="1" Background="#36516B" Canvas.Left="18" Canvas.Top="18" />
                  <Border Width="860" Height="1" Background="#24374A" Canvas.Left="18" Canvas.Top="52" />
                  <Border Width="860" Height="1" Background="#36516B" Canvas.Left="18" Canvas.Top="86" />
                  <TextBlock Text="100" Foreground="#718497" FontSize="9" Canvas.Left="2" Canvas.Top="7" />
                  <TextBlock Text="50" Foreground="#718497" FontSize="9" Canvas.Left="4" Canvas.Top="42" />
                  <TextBlock Text="0" Foreground="#718497" FontSize="9" Canvas.Left="8" Canvas.Top="77" />
                  <Canvas x:Name="SystemTrendPlotCanvas" Width="840" Height="105" Canvas.Left="28" Canvas.Top="0" />
                </Canvas>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="AssessmentPage" IsVisible="False" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="26,22" Spacing="18">
            <Border Classes="standardCard">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="7">
                  <TextBlock Text="LINUX PLATFORM BOUNDARY" Classes="eyebrow" />
                  <TextBlock x:Name="AssessmentSupportStatus" Text="Detecting…" Classes="cardTitle" />
                  <TextBlock x:Name="AssessmentPlatformSummary" Text="Reading /etc/os-release…" Classes="bodyText" />
                  <TextBlock x:Name="AssessmentSupportDetail" Foreground="#9FB0C0" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="AssessmentRunButton" Grid.Column="1" Classes="primary" Content="Run Read-Only Assessment" Click="RunAssessmentButton_OnClick" VerticalAlignment="Center" Margin="18,0,0,0" />
              </Grid>
            </Border>

            <StackPanel x:Name="AssessmentOverviewPanel" Spacing="18">
              <Border Classes="heroCard">
                <StackPanel Spacing="7">
                  <TextBlock Text="LINUX ASSESSMENT" Classes="eyebrow" />
                  <TextBlock Text="Choose What You Want to Review" Classes="pageHeading" />
                  <TextBlock Text="Pulse separates system facts, healthy findings, and guidance so you can focus on one kind of information at a time." Classes="bodyText" TextWrapping="Wrap" />
                  <TextBlock x:Name="AssessmentOverviewStatusText" Text="Run an assessment to populate these views." Foreground="#9FB0C0" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="*,14,*,14,*">
                <Button Grid.Column="0" x:Name="AssessmentInformationButton" Classes="assessmentChoice information" Tag="Information" Click="AssessmentSectionButton_OnClick">
                  <StackPanel Spacing="12">
                    <TextBlock Text="INFORMATION" Foreground="#00A6FF" FontSize="11" FontWeight="Bold" LetterSpacing="1" />
                    <TextBlock x:Name="AssessmentInformationCountText" Text="0" Foreground="#00A6FF" FontSize="38" FontWeight="Bold" />
                    <TextBlock Text="System facts and useful context that do not require action." Foreground="#DDE7F0" FontSize="13" TextWrapping="Wrap" />
                    <TextBlock Text="Open Information  →" Foreground="#00A6FF" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="2" x:Name="AssessmentHealthyButton" Classes="assessmentChoice healthy" Tag="Healthy" Click="AssessmentSectionButton_OnClick">
                  <StackPanel Spacing="12">
                    <TextBlock Text="HEALTHY" Foreground="#5CFF88" FontSize="11" FontWeight="Bold" LetterSpacing="1" />
                    <TextBlock x:Name="AssessmentHealthyCountText" Text="0" Foreground="#5CFF88" FontSize="38" FontWeight="Bold" />
                    <TextBlock Text="Evidence that Pulse checked and found working as expected." Foreground="#DDE7F0" FontSize="13" TextWrapping="Wrap" />
                    <TextBlock Text="Open Healthy Findings  →" Foreground="#5CFF88" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="4" x:Name="AssessmentGuidanceButton" Classes="assessmentChoice guidance" Tag="Guidance" Click="AssessmentSectionButton_OnClick">
                  <StackPanel Spacing="12">
                    <TextBlock Text="GUIDANCE" Foreground="#FFD13D" FontSize="11" FontWeight="Bold" LetterSpacing="1" />
                    <TextBlock x:Name="AssessmentGuidanceCountText" Text="0" Foreground="#FFD13D" FontSize="38" FontWeight="Bold" />
                    <TextBlock Text="Items that deserve review, unavailable coverage, and safe next steps." Foreground="#DDE7F0" FontSize="13" TextWrapping="Wrap" />
                    <TextBlock Text="Open Guidance  →" Foreground="#FFD13D" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
              </Grid>
            </StackPanel>

            <StackPanel x:Name="AssessmentInformationPanel" IsVisible="False" Spacing="14">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="5">
                  <TextBlock Text="Linux Information" Classes="pageHeading" />
                  <TextBlock Text="System facts and context. These cards do not represent faults or requested actions." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="secondary" Content="Back to Assessment" Tag="Overview" Click="AssessmentSectionButton_OnClick" />
              </Grid>
              <StackPanel x:Name="AssessmentInformationResultsPanel" Spacing="10" />
            </StackPanel>

            <StackPanel x:Name="AssessmentHealthyPanel" IsVisible="False" Spacing="14">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="5">
                  <TextBlock Text="Healthy Findings" Classes="pageHeading" />
                  <TextBlock Text="Evidence Pulse checked and found working as expected at the time of assessment." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="secondary" Content="Back to Assessment" Tag="Overview" Click="AssessmentSectionButton_OnClick" />
              </Grid>
              <StackPanel x:Name="AssessmentHealthyResultsPanel" Spacing="10" />
            </StackPanel>

            <StackPanel x:Name="AssessmentGuidancePanel" IsVisible="False" Spacing="14">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="5">
                  <TextBlock Text="Pulse Guidance" Classes="pageHeading" />
                  <TextBlock x:Name="AssessmentGuidanceText" Text="Review items and unavailable coverage will appear here with plain-language next steps." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="secondary" Content="Back to Assessment" Tag="Overview" Click="AssessmentSectionButton_OnClick" />
              </Grid>
              <StackPanel x:Name="AssessmentGuidanceResultsPanel" Spacing="10" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="PackagePage" IsVisible="False" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="26,22" Spacing="18">
            <Border Classes="heroCard">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="8">
                  <TextBlock Text="PACKAGE INTELLIGENCE" Classes="eyebrow" />
                  <TextBlock x:Name="PackageExecutiveStateText" Text="Pending Assessment" Classes="pageHeading" />
                  <TextBlock x:Name="PackageExecutiveDetailText" Text="Run an assessment to evaluate the local dpkg/APT package state without refreshing repositories or installing updates." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center" Margin="24,0,0,0">
                  <Button x:Name="PackageAssessButton" Classes="primary" Content="Run Assessment" Click="RunAssessmentButton_OnClick" />
                  <Button x:Name="PackageOpenReportButton" Classes="secondary" Content="Open Latest Report" Click="OpenLatestReportButton_OnClick" IsEnabled="False" />
                </StackPanel>
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,14,*" RowDefinitions="Auto,14,Auto,14,Auto">
              <Border Grid.Row="0" Grid.Column="0" Classes="standardCard">
                <StackPanel Spacing="9">
                  <TextBlock Text="Package Database" Classes="cardTitle" />
                  <TextBlock x:Name="PackageDatabaseStateText" Text="Pending Assessment" Foreground="#FFD13D" FontWeight="Bold" />
                  <TextBlock x:Name="PackageDatabaseDetailText" Text="dpkg consistency has not been assessed." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Row="0" Grid.Column="2" Classes="standardCard">
                <StackPanel Spacing="9">
                  <TextBlock Text="Installed Inventory" Classes="cardTitle" />
