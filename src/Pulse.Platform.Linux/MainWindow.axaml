<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Pulse.Platform.Linux.MainWindow"
        Title="Pulse Supernova Linux"
        Icon="/Assets/pulse-platform.png"
        Width="1180" Height="780"
        MinWidth="1040" MinHeight="700">
  <Grid ColumnDefinitions="230,*">
    <Border Grid.Column="0" Background="#080D16" BorderBrush="#24374A" BorderThickness="0,0,1,0">
      <Grid Margin="16" RowDefinitions="Auto,24,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="68,*">
          <Border Width="60" Height="60" CornerRadius="14" Background="#0C1623" BorderBrush="#36516B" BorderThickness="1">
            <Image Source="/Assets/PulseLogo-Dark.png" Stretch="UniformToFill" Margin="2" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
            <TextBlock Text="PULSE" Foreground="#00A6FF" FontSize="25" FontWeight="Bold" LetterSpacing="1.5" />
            <TextBlock Text="SUPERNOVA LINUX" Foreground="#FFD13D" FontSize="11" FontWeight="Bold" />
          </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="5">
            <TextBlock Text="PULSE HEALTH PLATFORM" Classes="navGroup" />
            <Button x:Name="DashboardNavButton" Classes="nav selected" Tag="Dashboard" Content="⌂   Dashboard" Click="NavigateButton_OnClick" />
            <Button x:Name="AssessmentNavButton" Classes="nav" Tag="Assessment" Content="◉   Linux Assessment" Click="NavigateButton_OnClick" />
            <Button x:Name="PackageNavButton" Classes="nav" Tag="Package" Content="▦   Package Intelligence" Click="NavigateButton_OnClick" />
            <Button x:Name="StorageNavButton" Classes="nav" Tag="Storage" Content="▣   Storage Intelligence" Click="NavigateButton_OnClick" />
            <Button x:Name="ReportsNavButton" Classes="nav" Tag="Reports" Content="▤   Reports" Click="NavigateButton_OnClick" />

            <Border Height="1" Background="#24445E" Margin="10,15,10,12" />
            <TextBlock Text="PULSE ADMINISTRATION" Classes="navGroup" />
            <Button x:Name="SchedulerNavButton" Classes="nav" Tag="Scheduler" Content="◷   Scheduler" Click="NavigateButton_OnClick" />
            <Button x:Name="LogsNavButton" Classes="nav" Tag="Logs" Content="≡   Logs" Click="NavigateButton_OnClick" />
            <Button x:Name="MissionControlNavButton" Classes="nav" Tag="MissionControl" Content="✦   Mission Control" Click="NavigateButton_OnClick" />
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Spacing="4" Margin="6,16,6,4">
          <TextBlock Text="System Health. Optimized." Foreground="#FFD13D" FontSize="11" FontWeight="SemiBold" />
          <TextBlock Text="Debian-family desktop port" Foreground="#718497" FontSize="10" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="82,*,62" Background="#0C121C">
      <Border Grid.Row="0" BorderBrush="#24374A" BorderThickness="0,0,0,1" Padding="26,16">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle" Text="Dashboard" Foreground="#00A6FF" FontSize="25" FontWeight="Bold" />
            <TextBlock Text="System Health. Optimized." Foreground="#B7C4D1" FontSize="12" />
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
            <TextBlock x:Name="VersionNameText" Text="Pulse Supernova Linux • Beta" Foreground="#FFD13D" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
            <TextBlock x:Name="BuildIdText" Text="Build ID: linux-x64" Foreground="#718497" FontSize="10" HorizontalAlignment="Right" Margin="0,5,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="26,20" Spacing="14">
            <Border Classes="standardCard" Padding="20">
              <Grid ColumnDefinitions="*,18,280" RowDefinitions="Auto,*">
                <Grid Grid.Row="0" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Current System State" Classes="pageHeading" />
                    <TextBlock x:Name="DashboardPlatformText" Text="Detecting platform…" Foreground="#9FB0C0" FontSize="11" />
                    <TextBlock x:Name="DashboardLastAssessmentText" Text="No saved assessment yet." Foreground="#718497" FontSize="10" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="DashboardAssessButton" Classes="primary" Content="Run Assessment" Click="RunAssessmentButton_OnClick" />
                    <Button x:Name="DashboardOpenReportButton" Classes="secondary" Content="Open Report" Click="OpenLatestReportButton_OnClick" IsEnabled="False" />
                  </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="18,190,150,170" RowDefinitions="36,36,36,36,36,36">
                  <Border x:Name="PlatformDomainDot" Grid.Row="0" Width="9" Height="9" CornerRadius="5" Background="#00A6FF" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="Linux Intelligence" Classes="bodyText" FontWeight="Bold" VerticalAlignment="Center" />
                  <TextBlock x:Name="PlatformDomainStateText" Grid.Row="0" Grid.Column="2" Text="Pending" Foreground="#00A6FF" FontWeight="Bold" VerticalAlignment="Center" />
                  <Grid Grid.Row="0" Grid.Column="3" ColumnDefinitions="135,*" VerticalAlignment="Center">
                    <Border Width="135" Height="11" Background="#102333" BorderBrush="#00A6FF" BorderThickness="1" HorizontalAlignment="Left">
                      <Border x:Name="PlatformDomainFill" Width="0" Background="#00A6FF" HorizontalAlignment="Left" />
                    </Border>
                    <TextBlock x:Name="PlatformDomainScoreText" Grid.Column="1" Text="--" Foreground="#DDE7F0" Margin="9,-2,0,0" />
                  </Grid>

                  <Border x:Name="PackageDomainDot" Grid.Row="1" Width="9" Height="9" CornerRadius="5" Background="#00A6FF" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="Package Intelligence" Classes="bodyText" FontWeight="Bold" VerticalAlignment="Center" />
                  <TextBlock x:Name="PackageDomainStateText" Grid.Row="1" Grid.Column="2" Text="Pending" Foreground="#00A6FF" FontWeight="Bold" VerticalAlignment="Center" />
                  <Grid Grid.Row="1" Grid.Column="3" ColumnDefinitions="135,*" VerticalAlignment="Center">
                    <Border Width="135" Height="11" Background="#102333" BorderBrush="#00A6FF" BorderThickness="1" HorizontalAlignment="Left"><Border x:Name="PackageDomainFill" Width="0" Background="#00A6FF" HorizontalAlignment="Left" /></Border>
                    <TextBlock x:Name="PackageDomainScoreText" Grid.Column="1" Text="--" Foreground="#DDE7F0" Margin="9,-2,0,0" />
                  </Grid>

                  <Border x:Name="NetworkDomainDot" Grid.Row="2" Width="9" Height="9" CornerRadius="5" Background="#00A6FF" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="Network Intelligence" Classes="bodyText" FontWeight="Bold" VerticalAlignment="Center" />
                  <TextBlock x:Name="NetworkDomainStateText" Grid.Row="2" Grid.Column="2" Text="Pending" Foreground="#00A6FF" FontWeight="Bold" VerticalAlignment="Center" />
                  <Grid Grid.Row="2" Grid.Column="3" ColumnDefinitions="135,*" VerticalAlignment="Center">
                    <Border Width="135" Height="11" Background="#102333" BorderBrush="#00A6FF" BorderThickness="1" HorizontalAlignment="Left"><Border x:Name="NetworkDomainFill" Width="0" Background="#00A6FF" HorizontalAlignment="Left" /></Border>
                    <TextBlock x:Name="NetworkDomainScoreText" Grid.Column="1" Text="--" Foreground="#DDE7F0" Margin="9,-2,0,0" />
                  </Grid>

                  <Border x:Name="StorageDomainDot" Grid.Row="3" Width="9" Height="9" CornerRadius="5" Background="#00A6FF" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="Storage Intelligence" Classes="bodyText" FontWeight="Bold" VerticalAlignment="Center" />
                  <TextBlock x:Name="StorageDomainStateText" Grid.Row="3" Grid.Column="2" Text="Pending" Foreground="#00A6FF" FontWeight="Bold" VerticalAlignment="Center" />
                  <Grid Grid.Row="3" Grid.Column="3" ColumnDefinitions="135,*" VerticalAlignment="Center">
                    <Border Width="135" Height="11" Background="#102333" BorderBrush="#00A6FF" BorderThickness="1" HorizontalAlignment="Left"><Border x:Name="StorageDomainFill" Width="0" Background="#00A6FF" HorizontalAlignment="Left" /></Border>
                    <TextBlock x:Name="StorageDomainScoreText" Grid.Column="1" Text="--" Foreground="#DDE7F0" Margin="9,-2,0,0" />
                  </Grid>

                  <Border x:Name="SecurityDomainDot" Grid.Row="4" Width="9" Height="9" CornerRadius="5" Background="#00A6FF" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="Security Intelligence" Classes="bodyText" FontWeight="Bold" VerticalAlignment="Center" />
                  <TextBlock x:Name="SecurityDomainStateText" Grid.Row="4" Grid.Column="2" Text="Pending" Foreground="#00A6FF" FontWeight="Bold" VerticalAlignment="Center" />
                  <Grid Grid.Row="4" Grid.Column="3" ColumnDefinitions="135,*" VerticalAlignment="Center">
                    <Border Width="135" Height="11" Background="#102333" BorderBrush="#00A6FF" BorderThickness="1" HorizontalAlignment="Left"><Border x:Name="SecurityDomainFill" Width="0" Background="#00A6FF" HorizontalAlignment="Left" /></Border>
                    <TextBlock x:Name="SecurityDomainScoreText" Grid.Column="1" Text="--" Foreground="#DDE7F0" Margin="9,-2,0,0" />
                  </Grid>

                  <Border x:Name="ReliabilityDomainDot" Grid.Row="5" Width="9" Height="9" CornerRadius="5" Background="#00A6FF" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="5" Grid.Column="1" Text="Reliability Intelligence" Classes="bodyText" FontWeight="Bold" VerticalAlignment="Center" />
                  <TextBlock x:Name="ReliabilityDomainStateText" Grid.Row="5" Grid.Column="2" Text="Pending" Foreground="#00A6FF" FontWeight="Bold" VerticalAlignment="Center" />
                  <Grid Grid.Row="5" Grid.Column="3" ColumnDefinitions="135,*" VerticalAlignment="Center">
                    <Border Width="135" Height="11" Background="#102333" BorderBrush="#00A6FF" BorderThickness="1" HorizontalAlignment="Left"><Border x:Name="ReliabilityDomainFill" Width="0" Background="#00A6FF" HorizontalAlignment="Left" /></Border>
                    <TextBlock x:Name="ReliabilityDomainScoreText" Grid.Column="1" Text="--" Foreground="#DDE7F0" Margin="9,-2,0,0" />
                  </Grid>
                </Grid>

                <Border Grid.Row="1" Grid.Column="2" Background="#090F18" BorderBrush="#00A6FF" BorderThickness="1" CornerRadius="14" Padding="18">
                  <StackPanel Spacing="7" HorizontalAlignment="Center">
                    <TextBlock Text="Executive Health" Foreground="#00A6FF" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="DashboardExecutiveScoreText" Text="--" Foreground="#00A6FF" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                      <Border x:Name="DashboardHealthDot" Width="10" Height="10" CornerRadius="5" Background="#00A6FF" VerticalAlignment="Center" />
                      <TextBlock x:Name="DashboardStateText" Text="Assessment Ready" Foreground="#00A6FF" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock x:Name="DashboardSummaryText" Text="Run an assessment to establish health." Foreground="#9FB0C0" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="225" />
                    <Grid Width="220" Height="13" ColumnDefinitions="*,*,*,*" Margin="0,5,0,0">
                      <Border Grid.Column="0" Background="#FF5B6E" CornerRadius="7,0,0,7" />
                      <Border Grid.Column="1" Background="#FF9F1C" />
                      <Border Grid.Column="2" Background="#FFD13D" />
                      <Border Grid.Column="3" Background="#5CFF88" CornerRadius="0,7,7,0" />
                    </Grid>
                    <Canvas Width="220" Height="16">
                      <TextBlock x:Name="DashboardGaugePointer" Text="▲" Foreground="#00A6FF" Canvas.Left="0" Canvas.Top="-4" />
                    </Canvas>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,14,*,14,*">
              <Border Grid.Column="0" Classes="standardCard" MinHeight="128">
                <StackPanel Spacing="8">
                  <TextBlock Text="Top Risk" Classes="cardTitle" />
                  <TextBlock x:Name="TopRiskText" Text="Assessment data has not been collected." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="standardCard" MinHeight="128">
                <StackPanel Spacing="8">
                  <TextBlock Text="Recent Changes" Classes="cardTitle" />
                  <TextBlock x:Name="RecentChangesText" Text="No assessment history yet." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Classes="standardCard" MinHeight="128">
                <Grid RowDefinitions="Auto,*,Auto">
                  <TextBlock Text="Supernova Advisor" Classes="cardTitle" />
                  <TextBlock Grid.Row="1" x:Name="RecommendationsText" Text="Run an assessment for plain-language guidance." Classes="bodyText" TextWrapping="Wrap" Margin="0,8,0,0" />
                  <Border x:Name="RequiredActionBorder" Grid.Row="2" Background="#12283A" BorderBrush="#36516B" BorderThickness="1" CornerRadius="7" Padding="8,5">
                    <TextBlock x:Name="RequiredActionText" Text="Assessment Required" Foreground="#DDE7F0" FontWeight="Bold" HorizontalAlignment="Center" />
                  </Border>
                </Grid>
              </Border>
            </Grid>

            <Border Classes="standardCard" Padding="16">
              <StackPanel Spacing="7">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Text="System Trend" Classes="cardTitle" />
                  <TextBlock Grid.Column="1" x:Name="SystemTrendText" Text="Trend data will appear after additional assessments." Foreground="#5CFF88" Margin="18,2,0,0" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="2" x:Name="DashboardEvidenceCountText" Text="0 evidence sources" Foreground="#9FB0C0" />
                </Grid>
                <Canvas x:Name="SystemTrendCanvas" Height="105" Background="#090F18">
                  <Border Width="860" Height="1" Background="#36516B" Canvas.Left="18" Canvas.Top="18" />
                  <Border Width="860" Height="1" Background="#24374A" Canvas.Left="18" Canvas.Top="52" />
                  <Border Width="860" Height="1" Background="#36516B" Canvas.Left="18" Canvas.Top="86" />
                  <TextBlock Text="100" Foreground="#718497" FontSize="9" Canvas.Left="2" Canvas.Top="7" />
                  <TextBlock Text="50" Foreground="#718497" FontSize="9" Canvas.Left="4" Canvas.Top="42" />
                  <TextBlock Text="0" Foreground="#718497" FontSize="9" Canvas.Left="8" Canvas.Top="77" />
                  <Canvas x:Name="SystemTrendPlotCanvas" Width="840" Height="105" Canvas.Left="28" Canvas.Top="0" />
                </Canvas>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="AssessmentPage" IsVisible="False" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="26,22" Spacing="18">
            <Border Classes="standardCard">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="7">
                  <TextBlock Text="LINUX PLATFORM BOUNDARY" Classes="eyebrow" />
                  <TextBlock x:Name="AssessmentSupportStatus" Text="Detecting…" Classes="cardTitle" />
                  <TextBlock x:Name="AssessmentPlatformSummary" Text="Reading /etc/os-release…" Classes="bodyText" />
                  <TextBlock x:Name="AssessmentSupportDetail" Foreground="#9FB0C0" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="AssessmentRunButton" Grid.Column="1" Classes="primary" Content="Run Read-Only Assessment" Click="RunAssessmentButton_OnClick" VerticalAlignment="Center" Margin="18,0,0,0" />
              </Grid>
            </Border>

            <Border Classes="standardCard">
              <StackPanel Spacing="12">
                <TextBlock Text="Assessment Evidence" Classes="cardTitle" />
                <StackPanel x:Name="AssessmentResultsPanel" Spacing="10">
                  <TextBlock Text="Assessment has not run in this session." Classes="bodyText" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="standardCard">
              <StackPanel Spacing="10">
                <TextBlock Text="Pulse Guidance" Classes="cardTitle" />
                <TextBlock x:Name="AssessmentGuidanceText" Text="Pulse discovers information, translates it into plain language, and advises before offering actions." Classes="bodyText" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="PackagePage" IsVisible="False" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="26,22" Spacing="18">
            <Border Classes="heroCard">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="8">
                  <TextBlock Text="PACKAGE INTELLIGENCE" Classes="eyebrow" />
                  <TextBlock x:Name="PackageExecutiveStateText" Text="Pending Assessment" Classes="pageHeading" />
                  <TextBlock x:Name="PackageExecutiveDetailText" Text="Run an assessment to evaluate the local dpkg/APT package state without refreshing repositories or installing updates." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center" Margin="24,0,0,0">
                  <Button x:Name="PackageAssessButton" Classes="primary" Content="Run Assessment" Click="RunAssessmentButton_OnClick" />
                  <Button x:Name="PackageOpenReportButton" Classes="secondary" Content="Open Latest Report" Click="OpenLatestReportButton_OnClick" IsEnabled="False" />
                </StackPanel>
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,14,*" RowDefinitions="Auto,14,Auto,14,Auto">
              <Border Grid.Row="0" Grid.Column="0" Classes="standardCard">
                <StackPanel Spacing="9">
                  <TextBlock Text="Package Database" Classes="cardTitle" />
                  <TextBlock x:Name="PackageDatabaseStateText" Text="Pending Assessment" Foreground="#FFD13D" FontWeight="Bold" />
                  <TextBlock x:Name="PackageDatabaseDetailText" Text="dpkg consistency has not been assessed." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Row="0" Grid.Column="2" Classes="standardCard">
                <StackPanel Spacing="9">
                  <TextBlock Text="Installed Inventory" Classes="cardTitle" />
                  <TextBlock x:Name="PackageInventoryStateText" Text="Pending Assessment" Foreground="#FFD13D" FontWeight="Bold" />
                  <TextBlock x:Name="PackageInventoryDetailText" Text="The installed package inventory has not been counted." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Row="2" Grid.Column="0" Classes="standardCard">
                <StackPanel Spacing="9">
                  <TextBlock Text="Available Updates" Classes="cardTitle" />
                  <TextBlock x:Name="PackageUpdatesStateText" Text="Pending Assessment" Foreground="#FFD13D" FontWeight="Bold" />
                  <TextBlock x:Name="PackageUpdatesDetailText" Text="Cached APT upgrade candidates have not been assessed." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Row="2" Grid.Column="2" Classes="standardCard">
                <StackPanel Spacing="9">
                  <TextBlock Text="Security Updates" Classes="cardTitle" />
                  <TextBlock x:Name="PackageSecurityStateText" Text="Pending Assessment" Foreground="#FFD13D" FontWeight="Bold" />
                  <TextBlock x:Name="PackageSecurityDetailText" Text="Cached security-update candidates have not been assessed." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Row="4" Grid.Column="0" Classes="standardCard">
                <StackPanel Spacing="9">
                  <TextBlock Text="Automatic Security Updates" Classes="cardTitle" />
                  <TextBlock x:Name="PackageAutomaticStateText" Text="Pending Assessment" Foreground="#FFD13D" FontWeight="Bold" />
                  <TextBlock x:Name="PackageAutomaticDetailText" Text="APT periodic-update configuration has not been assessed." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Row="4" Grid.Column="2" Classes="standardCard">
                <StackPanel Spacing="9">
                  <TextBlock Text="Restart Requirement" Classes="cardTitle" />
                  <TextBlock x:Name="PackageRestartStateText" Text="Pending Assessment" Foreground="#FFD13D" FontWeight="Bold" />
                  <TextBlock x:Name="PackageRestartDetailText" Text="The Debian restart-required marker has not been assessed." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Classes="standardCard">
              <StackPanel Spacing="8">
                <TextBlock Text="Recommended Next Step" Classes="cardTitle" />
                <TextBlock x:Name="PackageRecommendationText" Text="Run an assessment to establish Package Intelligence." Classes="bodyText" TextWrapping="Wrap" />
                <TextBlock Text="Package evidence is local and read-only. Pulse does not run apt update, download packages, install updates, repair dpkg, or restart the computer." Foreground="#718497" FontSize="10" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="StoragePage" IsVisible="False" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="26,22" Spacing="18">
            <Border Classes="heroCard">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="8">
                  <TextBlock Text="STORAGE INTELLIGENCE" Classes="eyebrow" />
                  <TextBlock x:Name="StorageExecutiveStateText" Text="Pending Assessment" Classes="pageHeading" />
                  <TextBlock x:Name="StorageExecutiveDetailText" Text="Run an assessment to evaluate capacity, root mount integrity, inode pressure, physical-drive indicators, encryption, and detectable backup posture." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center" Margin="24,0,0,0">
                  <Button x:Name="StorageAssessButton" Classes="primary" Content="Run Assessment" Click="RunAssessmentButton_OnClick" />
                  <Button x:Name="StorageOpenReportButton" Classes="secondary" Content="Open Latest Report" Click="OpenLatestReportButton_OnClick" IsEnabled="False" />
                </StackPanel>
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,14,*" RowDefinitions="Auto,14,Auto,14,Auto">
              <Border Grid.Row="0" Grid.Column="0" Classes="standardCard">
                <StackPanel Spacing="9">
                  <TextBlock Text="System Storage" Classes="cardTitle" />
                  <TextBlock x:Name="StorageCapacityStateText" Text="Pending Assessment" Foreground="#FFD13D" FontWeight="Bold" />
                  <TextBlock x:Name="StorageCapacityDetailText" Text="Root filesystem capacity has not been assessed." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Row="0" Grid.Column="2" Classes="standardCard">
                <StackPanel Spacing="9">
                  <TextBlock Text="Root Filesystem Mount" Classes="cardTitle" />
                  <TextBlock x:Name="StorageMountStateText" Text="Pending Assessment" Foreground="#FFD13D" FontWeight="Bold" />
                  <TextBlock x:Name="StorageMountDetailText" Text="Root filesystem type, source, and mount mode have not been assessed." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Row="2" Grid.Column="0" Classes="standardCard">
                <StackPanel Spacing="9">
                  <TextBlock Text="Filesystem Inode Capacity" Classes="cardTitle" />
                  <TextBlock x:Name="StorageInodeStateText" Text="Pending Assessment" Foreground="#FFD13D" FontWeight="Bold" />
                  <TextBlock x:Name="StorageInodeDetailText" Text="Root filesystem inode usage has not been assessed." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Row="2" Grid.Column="2" Classes="standardCard">
                <StackPanel Spacing="9">
                  <TextBlock Text="Physical Drive Health" Classes="cardTitle" />
                  <TextBlock x:Name="StorageDriveStateText" Text="Pending Assessment" Foreground="#FFD13D" FontWeight="Bold" />
                  <TextBlock x:Name="StorageDriveDetailText" Text="SMART/NVMe indicators have not been assessed." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Row="4" Grid.Column="0" Classes="standardCard">
                <StackPanel Spacing="9">
                  <TextBlock Text="Disk Encryption" Classes="cardTitle" />
                  <TextBlock x:Name="StorageEncryptionStateText" Text="Pending Assessment" Foreground="#FFD13D" FontWeight="Bold" />
                  <TextBlock x:Name="StorageEncryptionDetailText" Text="Readable LUKS metadata has not been assessed." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Row="4" Grid.Column="2" Classes="standardCard">
                <StackPanel Spacing="9">
                  <TextBlock Text="Backup Posture" Classes="cardTitle" />
                  <TextBlock x:Name="StorageBackupStateText" Text="Pending Assessment" Foreground="#FFD13D" FontWeight="Bold" />
                  <TextBlock x:Name="StorageBackupDetailText" Text="Known backup tools and configuration paths have not been assessed." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Classes="standardCard">
              <StackPanel Spacing="8">
                <TextBlock Text="Recommended Next Step" Classes="cardTitle" />
                <TextBlock x:Name="StorageRecommendationText" Text="Run an assessment to establish storage evidence." Classes="bodyText" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ReportsPage" IsVisible="False" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="26,22" Spacing="18">
            <Border Classes="heroCard">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="8">
                  <TextBlock Text="PRIMARY HTML REPORTS" Classes="eyebrow" />
                  <TextBlock Text="Pulse Health Report" Classes="pageHeading" />
                  <TextBlock Text="Aurora-styled HTML reports open in your browser and support Print / Save as PDF." Classes="bodyText" TextWrapping="Wrap" />
                  <TextBlock x:Name="LatestReportText" Text="No report has been generated yet." Foreground="#9FB0C0" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center" Margin="24,0,0,0">
                  <Button x:Name="ReportsOpenLatestButton" Classes="primary" Content="Open Latest Report" Click="OpenLatestReportButton_OnClick" IsEnabled="False" />
                  <Button Classes="secondary" Content="Open HTML Reports" Click="OpenReportsFolderButton_OnClick" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="standardCard">
              <StackPanel Spacing="12">
                <TextBlock Text="Recent HTML Reports" Classes="cardTitle" />
                <StackPanel x:Name="RecentReportsPanel" Spacing="8">
                  <TextBlock Text="No saved reports." Classes="bodyText" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="standardCard">
              <StackPanel Spacing="8">
                <TextBlock Text="Archived PDFs" Classes="cardTitle" />
                <TextBlock Text="HTML is the primary Pulse report format. Use your browser's Print / Save as PDF command when an archived PDF is needed." Classes="bodyText" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="SchedulerPage" IsVisible="False" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="26,22" Spacing="18">
            <Border Classes="heroCard">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="8">
                  <TextBlock Text="AUTOMATIC HEALTH SCANS" Classes="eyebrow" />
                  <TextBlock x:Name="SchedulerStateText" Text="Checking Schedule…" Classes="pageHeading" />
                  <TextBlock x:Name="SchedulerDetailText" Text="Reading systemd --user status…" Classes="bodyText" TextWrapping="Wrap" />
                  <TextBlock Text="Cadence: Weekly • Persistent catch-up • Up to 30-minute randomized delay" Foreground="#9FB0C0" FontSize="11" />
                </StackPanel>
                <Button x:Name="ScheduleButton" Grid.Column="1" Classes="primary" Content="Checking Schedule…" Click="ScheduleButton_OnClick" IsEnabled="False" VerticalAlignment="Center" Margin="24,0,0,0" />
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,14,*">
              <Border Grid.Column="0" Classes="standardCard">
                <StackPanel Spacing="9">
                  <TextBlock Text="What Pulse Runs" Classes="cardTitle" />
                  <TextBlock Text="The same Debian-family support gate and read-only evidence providers used by Run Assessment. Reports are saved without opening the graphical interface." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="standardCard">
                <StackPanel Spacing="9">
                  <TextBlock Text="Approval Boundary" Classes="cardTitle" />
                  <TextBlock Text="Scheduling is off by default. Enabling requires a second confirmation. Pulse uses systemd --user without sudo, Polkit, or a system-wide service." Classes="bodyText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="LogsPage" IsVisible="False" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="26,22" Spacing="18">
            <Border Classes="standardCard">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="7">
                  <TextBlock Text="PULSE EVENT LOG" Classes="eyebrow" />
                  <TextBlock Text="Assessment Activity" Classes="pageHeading" />
                  <TextBlock x:Name="LogsLocationText" Text="Loading log location…" Foreground="#9FB0C0" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Classes="secondary" Content="Refresh Logs" Click="RefreshLogsButton_OnClick" />
                  <Button Classes="secondary" Content="Open Logs Folder" Click="OpenLogsFolderButton_OnClick" />
                  <Button x:Name="ClearLogButton" Classes="danger" Content="Clear Event Log" Click="ClearLogButton_OnClick" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Classes="logCard">
              <TextBlock x:Name="LogsText" Text="No Pulse activity has been recorded." FontFamily="monospace" FontSize="11" Foreground="#C7D3DF" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="MissionControlPage" IsVisible="False" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="26,22" Spacing="18">
            <StackPanel Spacing="3">
              <TextBlock Text="Supernova Mission Control" Classes="pageHeading" />
              <TextBlock Text="Intelligence. UNIFIED." Foreground="#FFD13D" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>

            <Border Classes="heroCard">
              <Grid ColumnDefinitions="*,1,*">
                <StackPanel Grid.Column="0" Spacing="10" Margin="0,0,28,0">
                  <TextBlock Text="Current Mission" Classes="cardTitle" />
                  <TextBlock Text="Pulse Supernova Linux" Foreground="#FFD13D" FontSize="24" FontWeight="Bold" />
                  <TextBlock Text="Debian-family intelligence, GitHub release lifecycle, and extended-use testing." Classes="bodyText" TextWrapping="Wrap" />
                  <TextBlock Text="Mission Status: GitHub-enabled Linux beta build" Foreground="#00A6FF" FontWeight="Bold" />
                </StackPanel>
                <Border Grid.Column="1" Background="#00A6FF" Width="1" />
                <StackPanel Grid.Column="2" Spacing="10" Margin="28,0,0,0">
                  <TextBlock Text="What Pulse Does" Classes="cardTitle" />
                  <TextBlock Classes="bodyText" TextWrapping="Wrap"
                             Text="Pulse helps you understand the health, reliability, security posture, storage, and performance of your computer in one place. It explains what looks healthy and what may need attention, tracks changes over time, creates reports, and guides you to appropriate actions. Pulse will never silently repair or change your system without your consent." />
                </StackPanel>
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,14,*">
              <Border Grid.Column="0" Classes="standardCard">
                <StackPanel Spacing="11">
                  <TextBlock Text="Developer Information" Classes="cardTitle" />
                  <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Text="Development Version:" Classes="bodyText" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="MissionVersionText" Text="0.0.0.16" Foreground="#FFFFFF" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="Release Channel:" Classes="bodyText" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Beta" Foreground="#FFD13D" FontWeight="SemiBold" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="2" Text="Framework:" Classes="bodyText" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text=".NET 10 • Avalonia" Foreground="#FFFFFF" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="3" Text="Build ID:" Classes="bodyText" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="MissionBuildIdText" Text="linux-x64-0.0.0.16" Foreground="#FFFFFF" Margin="0,7,0,0" TextWrapping="Wrap" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Classes="standardCard">
                <StackPanel Spacing="11">
                  <TextBlock Text="System Information" Classes="cardTitle" />
                  <Grid ColumnDefinitions="118,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Text="Computer:" Classes="bodyText" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="MissionComputerText" Foreground="#FFFFFF" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="Distribution:" Classes="bodyText" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="MissionDistributionText" Foreground="#FFFFFF" Margin="0,7,0,0" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Text="Reports Folder:" Classes="bodyText" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MissionReportsFolderText" Foreground="#FFFFFF" Margin="0,7,0,0" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" Text="Settings Folder:" Classes="bodyText" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="MissionSettingsFolderText" Foreground="#FFFFFF" Margin="0,7,0,0" TextWrapping="Wrap" />
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>

            <Border Classes="standardCard">
              <StackPanel Spacing="8">
                <TextBlock Text="Pulse Supernova Linux" Classes="cardTitle" />
                <TextBlock Text="Linux launch identity" Foreground="#FFD13D" FontSize="17" FontWeight="Bold" />
                <TextBlock Text="Supernova preserves accepted Pulse intelligence and data while extending the unified product identity to verified Debian-family desktop systems." Classes="bodyText" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Border Grid.Row="2" Background="#080D16" BorderBrush="#24374A" BorderThickness="0,1,0,0" Padding="20,10">
        <Grid ColumnDefinitions="Auto,*,Auto,10,Auto">
          <TextBlock Text="ACTIVITY" Foreground="#00A6FF" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" x:Name="ActivityText" Text="Pulse Supernova Linux ready." Foreground="#9FB0C0" FontSize="11" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="2" Classes="compact" Content="Refresh Pulse" Click="RefreshPulseButton_OnClick" />
          <Button Grid.Column="4" Classes="compact" Content="Exit" Click="ExitButton_OnClick" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
