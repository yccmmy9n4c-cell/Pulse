<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.0.0.30</Version>
    <AssemblyVersion>0.0.0.30</AssemblyVersion>
    <FileVersion>0.0.0.30</FileVersion>
    <InformationalVersion>Pulse Linux Beta 0.0.0.30</InformationalVersion>
    <Product>Pulse Supernova Linux</Product>
    <Company>Pulse Platform</Company>
  </PropertyGroup>
</Project>
